# Copy this file to .env and fill in real values for anything beyond
# local development. Never commit the real .env file (it's gitignored).

ENVIRONMENT=development

# Defaults to a local SQLite file -- zero external setup needed.
# For Postgres: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./aegis.db

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REFRESH=120/minute
RATE_LIMIT_DEFAULT=120/minute

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

MAX_UPLOAD_BYTES=5242880

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phase 4 (computer vision infrastructure) ---------------------
# A private filesystem root -- NEVER served as a static directory. See
# docs/security/MEDIA_UPLOAD_SECURITY.md.
CV_MEDIA_STORAGE_ROOT=./media_storage
CV_MAX_IMAGE_UPLOAD_BYTES=10485760
CV_MAX_VIDEO_UPLOAD_BYTES=78643200
CV_MAX_IMAGE_DIMENSION_PX=6000
CV_MAX_VIDEO_DIMENSION_PX=4000
CV_VIDEO_FRAME_SAMPLE_INTERVAL_SECONDS=2.0
CV_VIDEO_MAX_FRAMES_PER_JOB=30
CV_MAX_VIDEO_DURATION_SECONDS=600.0
CV_DEFAULT_CONFIDENCE_THRESHOLD=0.35
CV_DEFAULT_NMS_IOU_THRESHOLD=0.45
CV_MAX_DETECTIONS_PER_FRAME=50

# Phase 12: retrieval + copilot. Defaults send NOTHING externally.
# See docs/security/COPILOT_PRIVACY.md before enabling a provider.
COPILOT_PROVIDER=none
COPILOT_ALLOW_EXTERNAL=false
COPILOT_API_KEY=
COPILOT_MODEL=
COPILOT_TIMEOUT_SECONDS=20
COPILOT_MAX_RETRIES=1
COPILOT_RATE_LIMIT_PER_MINUTE=20
COPILOT_CONVERSATION_RETENTION_DAYS=90
EMBEDDING_PROVIDER=none
RETRIEVAL_TOMBSTONE_DAYS=30

# --- Phase 13: scenario simulation limits (see docs/architecture/SCENARIO_SIMULATION.md)
SCENARIO_MAX_RUN_SECONDS=20
SCENARIO_MAX_SWEEP_SECONDS=45
SCENARIO_STALE_RUN_SECONDS=300
SCENARIO_MAX_SCENARIOS_PER_ORG=500
SCENARIO_MAX_RUNS_PER_SCENARIO=200
SCENARIO_MAX_DATASETS_PER_ORG=200
SCENARIO_MAX_RESULT_BYTES=400000

# --- Phase 14: security and governance (see docs/security/ENVIRONMENT_CONFIGURATION.md)
PASSWORD_MIN_LENGTH=10
MAX_REQUEST_BODY_BYTES=10485760
MAX_UPLOAD_REQUEST_BYTES=83886080
# ENABLE_API_DOCS=            # unset: on in development, off in production
SECURITY_HEADERS_ENABLED=true
AUDIT_MEDIA_ACCESS=true
TRUST_FORWARDED_HEADERS=false
AUDIT_RETENTION_DAYS=0
LIFECYCLE_REQUIRE_SEPARATE_APPROVER=true
LIFECYCLE_SCENARIO_RUN_RETENTION_DAYS=180
LIFECYCLE_SYNTHETIC_DATASET_RETENTION_DAYS=90
LIFECYCLE_MEDIA_RETENTION_DAYS=0
LIFECYCLE_MAX_BATCH=200

# --- Phase 15: MLOps and observability -------------------------------------------
LOG_FORMAT=text                      # "json" for one structured JSON object per log line (secrets redacted in both)
METRICS_ENABLED=true
METRICS_MAX_SERIES_PER_METRIC=200
APP_GIT_COMMIT=                      # optional; recorded in experiment reproducibility metadata
MLOPS_ARTIFACT_ROOT=                 # directory for artifact:<relative path> references; empty = file artifacts are "unavailable"
MLOPS_MAX_EVAL_SAMPLES=5000
MLOPS_MAX_DETECTION_FIXTURE_SAMPLES=200
MLOPS_MAX_METADATA_BYTES=16384
MLOPS_STALE_RUN_SECONDS=600
MLOPS_EVALUATION_STALE_DAYS=30
MLOPS_APPROVAL_MAX_EVAL_AGE_DAYS=90
MLOPS_REQUIRE_SEPARATE_APPROVER=true
MLOPS_REGRESSION_ABS_THRESHOLD=0.05
MLOPS_REGRESSION_THRESHOLDS_JSON=    # e.g. {"classification": {"macro_f1": 0.03}}
MLOPS_METRIC_FLOORS_JSON=            # e.g. {"object_detection": {"recall": 0.5}}
MLOPS_MONITOR_MAX_ROWS=2000
MLOPS_MONITOR_MAX_FEATURES=30
MLOPS_MONITOR_MIN_SAMPLES=30
MLOPS_MONITOR_MIN_LABELLED=30
MLOPS_PSI_WARN=0.10
MLOPS_PSI_ALERT=0.25
MLOPS_SCHEMA_VIOLATION_RATE_WARN=0.05
MLOPS_JOB_FAILURE_RATE_THRESHOLD=0.20
MLOPS_JOB_WINDOW_HOURS=24
MLOPS_JOB_MIN_SAMPLES=10
MLOPS_MONITOR_FRESHNESS_DAYS=7

# Phase 16: analytics and reporting
ANALYTICS_MAX_WINDOW_DAYS=366
ANALYTICS_DEFAULT_WINDOW_DAYS=7
ANALYTICS_MAX_ROWS=20000
ANALYTICS_STALE_HOURS=24
ANALYTICS_LATE_ARRIVAL_HOURS=24
ANALYTICS_MIN_FINISHED_JOBS=10
ANALYTICS_GEO_MIN_CELL_COUNT=3
# Empty = <CV_MEDIA_STORAGE_ROOT>/reports. Private directory, never served statically.
REPORT_STORAGE_ROOT=
REPORT_RETENTION_DAYS=30
REPORT_MAX_ARTIFACT_BYTES=10485760
REPORT_MAX_NOTES_CHARS=4000
