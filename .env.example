# docker-compose settings. Copy to .env (git-ignored) and fill in the REQUIRED values.
# (The backend's own settings reference is backend/.env.example.)

# REQUIRED. Random database password for the bundled PostgreSQL.
AEGIS_DB_PASSWORD=

# REQUIRED. JWT signing secret, >= 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs everyone out (see docs/operations/ADMINISTRATOR_GUIDE.md).
AEGIS_SECRET_KEY=

# Optional. production (default) enforces startup checks; use development only on a throwaway local machine.
AEGIS_ENVIRONMENT=production
# Browser origins allowed to call the API directly (the bundled nginx proxy is same-origin and needs none).
AEGIS_CORS_ORIGINS=http://localhost:8080
# Set true only when a trusted reverse proxy in front sets X-Forwarded-* headers.
AEGIS_TRUST_FORWARDED_HEADERS=false
AEGIS_HTTP_PORT=8080
# json (default, one object per line) or text.
AEGIS_LOG_FORMAT=json
# Optional, PUBLIC map tile URL template baked into the frontend at build time (empty = no map tiles).
# Read docs/operations/MAP_PROVIDER_CONFIGURATION.md first; tile requests go from the browser to that host.
AEGIS_MAP_TILE_URL=
